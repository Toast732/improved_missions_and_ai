{
	"folders": [
		{
			"name": "Addon",
			"path": ".."
		}
	],
	"settings": {
		"editor.fontFamily": "'Roboto Mono'",
		"lifeboatapi.stormworks.isAddonProject": true,
		"editor.insertSpaces": false,
		"editor.detectIndentation": false,
		"editor.wordWrapColumn": 80,
		"html.format.wrapLineLength": 120,
